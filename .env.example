# Copy this file to .env and fill in real values. Never commit .env to git.

# Brevo dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an email address you verified as a "Sender" in Brevo
# (Senders, Domains & Dedicated IPs -> Senders -> Add a sender). No domain needed —
# even a free Gmail/Outlook address works as long as you complete the verification email.
FROM_EMAIL=you@example.com
FROM_NAME=Skyflip

# Only the agent (you) should know this. Required to create a booking — anyone
# without it can still search flights and track existing bookings, but can't book new ones.
# Pick something long and hard to guess, not a real word.
BOOKING_PASSCODE=change-this-to-something-only-you-know

# From Neon (neon.tech) -> your project -> Connection Details -> copy the connection string.
# This is what makes bookings visible from any device instead of just one browser.
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

PORT=3001
